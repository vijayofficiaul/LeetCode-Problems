Next Greater Element I
https://leetcode.com/problems/next-greater-element-i?envType=problem-list-v2&envId=vmgzc3ut

class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {

        int[] ans = new int[nums1.length];

        for (int i = 0; i < nums1.length; i++) {
            int current = nums1[i];
            int indexInNums2 = -1;

            for (int j = 0; j < nums2.length; j++) {
                if (nums2[j] == current) {
                    indexInNums2 = j;
                    break;
                }
            }

            int nextGreater = -1;
            for (int k = indexInNums2 + 1; k < nums2.length; k++) {
                if (nums2[k] > current) {
                    nextGreater = nums2[k];
                    break;
                }
            }

            ans[i] = nextGreater;
        }

        return ans;
    }
}
