// Problem 485. Max Consecutive Ones
// Link: https://leetcode.com/problems/max-consecutive-ones?envType=problem-list-v2&envId=vmgzc3ut

class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int i=0;
        int count = 0;
        int max = 0;

        while(i<nums.length){
            if(nums[i] == 1){
                count +=1;
            }else if(nums[i] == 0){
                count = 0;
            }
            if(count > max){
                max = count;
            }
            i++;
        }
        return max;
    }
}
